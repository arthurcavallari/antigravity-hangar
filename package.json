{
  "name": "antigravity-hangar",
  "version": "1.1.1",
  "type": "module",
  "description": "Hangar — Chrome-style project-aware tab multiplexer, split-pane telemetry host, and extension marketplace for Google Antigravity Auxiliary Pane sidecars.",
  "license": "MIT",
  "author": {
    "name": "Arthur Cavallari",
    "url": "https://github.com/arthurcavallari"
  },
  "homepage": "https://github.com/arthurcavallari/antigravity-hangar#readme",
  "bugs": {
    "url": "https://github.com/arthurcavallari/antigravity-hangar/issues"
  },
  "files": [
    "sidecar.json",
    "registry.json",
    "server.mjs",
    "setup.mjs",
    "lib",
    "ui"
  ],
  "keywords": [
    "antigravity",
    "google-antigravity",
    "agy",
    "agy-plugin",
    "antigravity-sidecar",
    "antigravity-plugin",
    "antigravity-extension",
    "antigravity-ide",
    "sidecar",
    "multiplexer",
    "plugin-manager",
    "extension-manager",
    "gemini",
    "ai-coding",
    "agentic-coding"
  ],
  "bin": {
    "antigravity-hangar": "./setup.mjs",
    "agy-hangar": "./setup.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurcavallari/antigravity-hangar.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "agy-plugin-porter": "^0.1.0",
    "antigravity-sidecar-kit": "^1.2.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "setup": "node setup.mjs",
    "uninstall": "node setup.mjs --uninstall",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm test",
    "validate:registry": "node scripts/validate-registry.mjs"
  }
}
